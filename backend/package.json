{
  "name": "mmori-backend",
  "version": "1.0.0",
  "description": "Node/Express reimplementation of MoriBackEnd — the API behind the mMori Angular frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:life-expectancy": "tsx src/scripts/seed-life-expectancy.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
