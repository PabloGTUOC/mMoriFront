# Dependencies
node_modules/

# Build output
dist/

# Environment — never commit real credentials (BACKEND_SPEC §9 flagged plaintext
# credentials committed in the Rails repo; .env.example is the template to copy)
.env
.env.local
.env.*.local

# Firebase service account key. A real secret, unlike the web config in
# src/environments/environment.ts. The directory is tracked so the compose mount has
# something to bind to; its contents never are.
secrets/*
!secrets/.gitkeep

# Test + tooling artefacts
coverage/
.vitest/
*.log

# Cached mongod binaries downloaded by mongodb-memory-server
.cache/
