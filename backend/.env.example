# Copy to .env and fill in. Never commit the real file.

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database ----
# The Angular frontend's data lives here. Database name matches BACKEND_SPEC §3.
MONGODB_URI=mongodb://localhost:27017/trainingappDB

# ---- CORS ----
# Comma-separated. The Angular dev server runs on :4200; add your deployed origin here
# rather than editing code (BACKEND_SPEC §9.2).
CORS_ORIGINS=http://localhost:4200

# ---- OpenAI (POST /generate_recommendation) ----
# Without a key that endpoint returns 422 and the "Thoughts of the Day" screen shows the
# mood but no recommendation. Everything else works.
# CHATGPT_API_KEY is accepted as an alias, which is the name the Rails backend used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_MS=20000

# ---- Authentication (FRONTEND_IMPROVEMENT_PLAN.md Phase 4) ----
# disabled | optional | required. Defaults to `required`: the frontend no longer sends a
# user_id, so identity comes only from the token and FIREBASE_SERVICE_ACCOUNT_JSON below is
# then mandatory. Use `disabled` to run locally without Firebase at all — every request is
# then treated as DEV_USER_ID, i.e. one shared local account.
AUTH_MODE=required
# Identity used when AUTH_MODE=disabled and the caller names no user.
DEV_USER_ID=local-dev-user
# Costs a network round trip per request; catches sign-out-everywhere and disabled accounts.
AUTH_CHECK_REVOKED=false
# A REAL SECRET, unlike the frontend Firebase config. Service account JSON, inline.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a path.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Bounds on POST /generate_recommendation, the only endpoint that costs money per call.
RECOMMENDATION_RATE_LIMIT=10
RECOMMENDATION_RATE_WINDOW_MS=3600000

# ---- Tests ----
# Optional. Point the integration suite at an existing MongoDB; if unset, the tests spin
# up an ephemeral in-memory instance, and skip if neither is available.
# TEST_MONGODB_URI=mongodb://localhost:27017/mmori_test
