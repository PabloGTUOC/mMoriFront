    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "angular-eslint": "^18.4.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
